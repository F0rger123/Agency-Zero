# ── Agency Zero environment ────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local. These two values come from your Supabase project:
#   Supabase dashboard → Project Settings → API

# Required — Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Required — Supabase publishable (anon) key. Safe for the browser:
# row-level security (see supabase/migrations) is the real gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — canonical site URL used for auth redirects in production
# (defaults to the request origin in development).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
