# Agency Zero environment template
# Copy to .env.local for local Next.js development. Never commit .env.local,
# .env.production, .dev.vars, or real values.
#
# Cloudflare Workers Builds must receive the same three values as build
# variables/secrets because NEXT_PUBLIC_* values are used during the Next.js
# build. Set the values in the deployed Worker environment as well when using
# a deployment workflow that does not bake them into the build.

# Required — Supabase Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Required — Supabase Project Settings → API → publishable key (legacy anon key
# also works). This key is intended for browser use; Postgres RLS is the gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for a production deployment — the canonical public app origin,
# without a trailing slash. Also set this exact URL as Supabase Auth's Site URL.
# Example: https://agency.example.com
NEXT_PUBLIC_SITE_URL=https://theagencyzero.com

# Optional — email yourself when someone submits the website contact form.
# (Leads are always saved to the CRM; this only adds an email.) See docs/DEPLOYMENT.md.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=


# Optional: search-console verification tokens (the content="..." value Google / Bing give you), so the site can be claimed
# without uploading a file.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional: the public Google Business Profile link (from the profile's Share button), added to the site's structured data.
NEXT_PUBLIC_GBP_URL=

# Passkeys (WebAuthn sign-in for the CRM, migration 0026). SERVER-ONLY SECRET: Supabase dashboard > Project Settings > API >
# service_role key. Add it as an encrypted Secret on the Cloudflare Worker (never as a NEXT_PUBLIC_ variable). It is used only after a
# passkey signature has been verified (to read app_owner/app_team and start the session) and for passkey challenge bookkeeping.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets the CRM Quick note organise dictated notes with AI (server-only SECRET; add it as an encrypted Secret on the Cloudflare Worker,
# never as a NEXT_PUBLIC_ variable). Without it Quick note still works with a simple built-in organiser.
ANTHROPIC_API_KEY=
